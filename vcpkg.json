{
    "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
    "name": "commonlibsse-sample-plugin",
    "description": "Sample SKSE plugin based on CommonLibSSE, for unified AE/SE/VR deployment.",
    "homepage": "https://www.skyrimng.com",
    "license": "Apache-2.0",
    "features": {
        "plugin": {
            "description": "Build the SKSE plugin.",
            "dependencies": [
                "commonlibsse-gg",
                "detours",
                {
                    "name": "directxmath",
                    "version>=": "2025-04-03"
                },
                {
                    "name": "directxtk",
                    "version>=": "2025-10-27"
                },
                "openvr",                 
                "boost-algorithm",
                "boost-math",
                "boost-lexical-cast",
                "boost-property-tree",
                {
                    "name": "spdlog",
                    "version>=": "1.16.0"
                }
            ]
        },
        "tests": {
            "description": "Build tests for the SKSE plugin.",
            "dependencies": [
                {
                    "name": "commonlibsse-sample-plugin",
                    "default-features": false,
                    "features": [
                        "plugin"
                    ]
                },
                "catch2",
                {
                    "name": "spdlog",
                    "version>=": "1.16.0"
                }
            ]
        }
    },
    "overrides": [
        {
            "name": "boost-algorithm",
            "version": "1.86.0"
        },
        {
            "name": "boost-math",
            "version": "1.86.0"
        },
        {
            "name": "boost-lexical-cast",
            "version": "1.86.0"
        },
        {
            "name": "boost-property-tree",
            "version": "1.86.0"
        }
    ],
    "builtin-baseline": "8cbab05e499a6fc3893c9a6125d51b6d7d877dcc",
    "default-features": [
        "plugin",
        "tests"
    ]
}
